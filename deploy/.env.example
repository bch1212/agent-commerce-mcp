# Agent Commerce MCP — env template

# ─── Server ─────────────────────────────────────────────────────────────
MCP_SERVER_NAME=agent-commerce-mcp
MCP_TRANSPORT=http
PORT=3100
CATALOG_PATH=/app/catalog
BASE_URL=https://commerce.halversonco.com

# Enables stateful tools. Leave unset for public read-only mode.
AGENT_COMMERCE_WRITE_TOKEN=replace-with-generated-random-token

# Rate limiting. TRUST_PROXY should only be true behind a trusted proxy.
MCP_RATE_LIMIT_WINDOW_MS=60000
MCP_RATE_LIMIT_MAX_REQUESTS=120
MCP_RATE_LIMIT_MAX_CLIENTS=10000
MCP_SESSION_MAX=1000
MCP_SESSION_TTL_MS=1800000
TRUST_PROXY=false

# ─── Stripe (live) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
STRIPE_SUCCESS_URL=https://halversonco.com/success?session={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://halversonco.com/cancel

# ─── Gumroad ────────────────────────────────────────────────────────────
GUMROAD_ACCESS_TOKEN=replace-with-gumroad-access-token

# ─── AgentTrust ─────────────────────────────────────────────────────────
AGENTTRUST_MCP_ENDPOINT=https://agenttrust-mcp-production.up.railway.app/mcp
AGENTTRUST_VENDOR_ID=halversoniq

# ─── Salesbot integration ───────────────────────────────────────────────
SALESBOT_WEBHOOK_URL=https://salesbot.halversonco.com/commerce/events
SALESBOT_ADMIN_TOKEN=replace-with-salesbot-admin-token
SALESBOT_LEAD_CAPTURE_URL=https://salesbot.halversonco.com/leads/capture

# ─── Discord ────────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=
